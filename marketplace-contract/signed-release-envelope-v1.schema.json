{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artio.example/schemas/signed-release-envelope-v1.schema.json",
  "title": "Artio Signed Release Descriptor Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor", "signature"],
  "properties": {
    "descriptor": {"$ref": "./release-descriptor-v1.schema.json"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,100}$"}
      }
    }
  }
}

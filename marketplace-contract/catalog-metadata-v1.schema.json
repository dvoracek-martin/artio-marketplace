{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.artio.io/schemas/catalog-metadata-v1.json",
  "title": "Artio Marketplace CatalogMetadataV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "slug", "title", "tagline", "description", "vendorDisplayName", "author", "pricingModel", "categories", "tags", "icon", "screenshots", "releaseNotes"],
  "properties": {
    "schemaVersion": {"const": 1}, "pluginId": {"type": "string", "minLength": 1, "maxLength": 160},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120},
    "title": {"$ref": "#/$defs/localized120"}, "tagline": {"$ref": "#/$defs/localized200"}, "description": {"$ref": "#/$defs/localized10000"},
    "vendorDisplayName": {"type": "string", "minLength": 1, "maxLength": 120}, "author": {"type": "string", "minLength": 1, "maxLength": 120},
    "publisherWebsite": {"$ref": "#/$defs/https"}, "supportUrl": {"$ref": "#/$defs/https"}, "documentationUrl": {"$ref": "#/$defs/https"}, "sourceUrl": {"$ref": "#/$defs/https"}, "licenseName": {"type": ["string", "null"], "maxLength": 120}, "licenseUrl": {"$ref": "#/$defs/https"},
    "pricingModel": {"const": "FREE"}, "categories": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["analytics", "catalog", "communication", "payments", "shipping", "security", "operations", "other"]}},
    "tags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"}}, "icon": {"type": "string", "pattern": "^sha256-[a-f0-9]{64}$"},
    "screenshots": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["assetId", "order", "alt"], "properties": {"assetId": {"type": "string", "pattern": "^sha256-[a-f0-9]{64}$"}, "order": {"type": "integer", "minimum": 0}, "alt": {"$ref": "#/$defs/localized300"}, "caption": {"$ref": "#/$defs/localized500"}}}},
    "highlights": {"$ref": "#/$defs/localizedHighlights"}, "releaseNotes": {"$ref": "#/$defs/localized10000"}
  },
  "$defs": {
    "https": {"type": ["string", "null"], "format": "uri", "pattern": "^https://[^\\s]+$"},
    "localized120": {"$ref": "#/$defs/localized", "maxLength": 120}, "localized200": {"$ref": "#/$defs/localized", "maxLength": 200}, "localized300": {"$ref": "#/$defs/localized", "maxLength": 300}, "localized500": {"$ref": "#/$defs/localized", "maxLength": 500}, "localized10000": {"$ref": "#/$defs/localized", "maxLength": 10000},
    "localized": {"type": "object", "required": ["en"], "additionalProperties": false, "properties": {"en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}, "fr": {"type": "string", "minLength": 1}, "it": {"type": "string", "minLength": 1}}},
    "localizedHighlights": {"type": "object", "required": ["en"], "additionalProperties": false, "properties": {"en": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 120}}, "de": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 120}}, "fr": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 120}}, "it": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 120}}}}
  }
}

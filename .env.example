# Copy to .env and replace every value. Local-only values must never be reused in production.
POSTGRES_PASSWORD=replace-with-unique-random-password
MARKETPLACE_PUBLISHER_TOKEN_SHA256=replace-with-64-lowercase-hex-sha256
MARKETPLACE_REGISTRY_HOST=localhost:5000
MARKETPLACE_REGISTRY_PUBLISH_HOST=localhost:5001
MARKETPLACE_API_PORT=8080
MARKETPLACE_REGISTRY_PORT=5000
MARKETPLACE_REGISTRY_PUBLISH_PORT=5001
# Keep this credential file outside the Git repository; it contains a bcrypt htpasswd entry.
ZOT_HTPASSWD_FILE=../artio-marketplace-secrets/zot.htpasswd

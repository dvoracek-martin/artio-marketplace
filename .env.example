# Copy to .env and replace every value. Local-only values must never be reused in production.
POSTGRES_PASSWORD=replace-with-unique-random-password
MARKETPLACE_PUBLISHER_TOKEN_SHA256=replace-with-64-lowercase-hex-sha256
MARKETPLACE_ADMIN_TOKEN_SHA256=replace-with-separate-64-lowercase-hex-sha256
MARKETPLACE_REVOCATION_TOKEN_SHA256=replace-with-separate-64-lowercase-hex-sha256
MARKETPLACE_SIGNING_INGEST_TOKEN_SHA256=replace-with-separate-64-lowercase-hex-sha256
MARKETPLACE_SIGNING_TRUSTED_KEYS=
MARKETPLACE_REGISTRY_HOST=localhost:5000
MARKETPLACE_REGISTRY_PUBLISH_HOST=localhost:5001
MARKETPLACE_API_PORT=8080
MARKETPLACE_MANAGEMENT_PORT=8081
MARKETPLACE_REGISTRY_PORT=5000
MARKETPLACE_REGISTRY_PUBLISH_PORT=5001
MARKETPLACE_REGISTRY_ALLOWED_REPOSITORY_PREFIXES=public/plugins/
MARKETPLACE_ZOT_PROMOTION_USERNAME=promoter
MARKETPLACE_ZOT_PROMOTION_PASSWORD=replace-with-unique-random-secret
# Required: replace with the exact address/CIDR observed as the Marketplace
# socket peer for the HTTPS reverse proxy. Never guess or trust all private IPs.
MARKETPLACE_RATE_LIMIT_TRUSTED_PROXIES=replace-with-proxy-peer-address-or-cidr
# Keep this credential file outside the Git repository; it contains a bcrypt htpasswd entry.
ZOT_HTPASSWD_FILE=../artio-marketplace-secrets/zot.htpasswd
